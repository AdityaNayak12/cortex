# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (zero setup). Switch to Postgres for production.
DATABASE_URL=sqlite:///./cortex.db
# DATABASE_URL=postgresql://user:password@localhost:5432/cortex

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-api-key

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
